DATABASE_URL=mysql+aiomysql://researchos:researchos@mysql:3306/researchos
MYSQL_ROOT_PASSWORD=local-root-change-me
MYSQL_PASSWORD=researchos
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:3000
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
INPUT_PRICE_PER_MILLION=0.4
OUTPUT_PRICE_PER_MILLION=1.6
SEARCH_PRICE_PER_CALL=0.008
ORGANIZATION_BUDGET=50
# Optional provider failover (JSON, max 3). Prices are required so cost accounting stays correct.
# LLM_FALLBACKS=[{"provider":"gemini","model":"<model-id>","input_price_per_million":0.3,"output_price_per_million":2.5}]
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_COOLDOWN_SECONDS=60
